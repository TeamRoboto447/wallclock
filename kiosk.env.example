# Copy to kiosk.env (laptop, read by scripts/dev.sh) or /etc/tvgui/kiosk.env (Pi, loaded by the systemd units).
# Plain KEY=value lines, no quotes, no backticks (the file is sourced by a shell). Never commit the real file.

# Badge tags: the write password for NTAG enrolment (enrolling/writing tags only).
TVGUI_TAG_SECRET=change-me

# Authentik roster sync (read-only). AUTHENTIK_URL defaults to https://members.teamroboto.org
AUTHENTIK_TOKEN=
#AUTHENTIK_URL=https://members.teamroboto.org

# Leantime plan/tasks sync. LEANTIME_URL defaults to https://tasks.teamroboto.org
LEANTIME_API_KEY=
#LEANTIME_URL=https://tasks.teamroboto.org
#LEANTIME_PROJECT=7
#LEANTIME_INTERVAL=15
# Writes milestone dates BACK to Leantime (needs an Editor key). Leave unset unless you mean it;
# scripts/dev.sh always unsets it.
#LEANTIME_ROLL_FORWARD=1

# frc.nexus (pit display): API key, the event key, and our team number (the schedule and next match show only its matches).
FRC_NEXUS_API_KEY=
TVGUI_NEXUS_EVENT=demo1509
TVGUI_TEAM=447

# Slack "Important Team Communications" module: bot token (channels:history or groups:history + users:read)
# and the channel ID (C... / G...). Invite the bot to the channel first.
SLACK_BOT_TOKEN=
TVGUI_SLACK_CHANNEL=

# Clock-in rules: 1 = refuse a clock-in without a pick. Pit display: a location; shop display: a milestone/project.
#TVGUI_REQUIRE_LOCATION=1
#TVGUI_REQUIRE_WORK=1

# Display: which layout to show (default py/layouts/shop.json), screen blanking after N idle seconds (0 = never),
# and 1 to disable the Stream Deck thread.
#TVGUI_LAYOUT=/usr/local/share/tvgui/layouts/pit.json
#TVGUI_BLANK_SECS=0
#TVGUI_NO_DECK=1

# Overrides you rarely need (scripts/dev.sh sets the laptop ones itself): speech binary/voice, audio sink
# (empty = default sink), database and plan-file locations, control socket.
#TVGUI_PIPER=/usr/local/bin/piper
#TVGUI_PIPER_MODEL=/usr/local/share/tvgui/voices/en_US-bryce-medium.onnx
#TVGUI_AUDIO_TARGET=alsa-hdmi
#TVGUI_DB=/var/lib/tvgui/attendance.sqlite
#TVGUI_BOARD=/var/lib/tvgui
#TVGUI_SOCK=/run/tvgui/ctl.sock
